# This machine's Tailscale IPv4 (`tailscale ip -4`), so the port is reachable only on the tailnet.
LLM_BIND=100.64.0.10
# Folder containing the GGUF (download with scripts/download-model.sh <folder>).
MODELS_DIR=/mnt/user/appdata/templatize/models
# Optional overrides
# LLM_PORT=8080
# LLM_CTX=16384
# LLM_GPU_LAYERS=99
# LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-vulkan-b11946   # or server-cuda-b11946, server-b11946 (CPU)
