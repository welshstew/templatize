# Host port the app listens on (loopback). Pick one the other sites don't use.
DEMO_PORT=8100
# Address(es) the reverse proxy connects from, comma-separated. Caddy installed on
# the host: 127.0.0.1. Caddy in a container: that network's gateway or Caddy's
# address (docker network inspect <network>), or publish DEMO_BIND on it.
TRUSTED_PROXIES=127.0.0.1
# Requests per minute per client IP (static files and /healthz are exempt).
RATE_LIMIT=120/minute
NER_THREADS=2
