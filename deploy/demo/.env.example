# Docker network of the Caddy container (docker network ls). Lockstep's demo: lockstep-demo_default.
PROXY_NETWORK=lockstep-demo_default
# Where Caddy connects from, comma-separated IPs/CIDRs: that network's subnet
# (docker network inspect <network> --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}').
TRUSTED_PROXIES=172.18.0.0/16
# Requests per minute per client IP (static files and /healthz are exempt).
RATE_LIMIT=120/minute
NER_THREADS=2
