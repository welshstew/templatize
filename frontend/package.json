{
  "name": "templatize-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-no-external-urls.mjs dist",
    "typecheck": "tsc --noEmit",
